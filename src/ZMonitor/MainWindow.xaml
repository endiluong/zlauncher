<Window x:Class="ZMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZMonitor"
        Title="ZMonitor" Icon="pack://application:,,,/z.ico" Width="300" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="-20000" Top="-20000"
        Background="Transparent" Foreground="#F5FFFFFF"
        FontFamily="Segoe UI Variable Display, Segoe UI" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" MouseLeftButtonDown="OnMouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="CpuBrush" Color="#0A84FF"/>
        <SolidColorBrush x:Key="GpuBrush" Color="#BF5AF2"/>
        <SolidColorBrush x:Key="RamBrush" Color="#FF9F0A"/>
        <SolidColorBrush x:Key="NetBrush" Color="#64D2FF"/>
        <SolidColorBrush x:Key="UpBrush" Color="#30D158"/>
        <SolidColorBrush x:Key="Dim" Color="#8CFFFFFF"/>

        <!-- Borderless clickable header (also stops the click from starting a window drag) -->
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F5FFFFFF"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="Faint" Color="#59FFFFFF"/>

        <Style x:Key="Chevron" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE70D;"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,1,0,0"/>
        </Style>
        <!-- Header values shown when a section is collapsed -->
        <Style x:Key="Summary" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,10,12,12"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="Track" TargetType="Border">
            <Setter Property="Height" Value="5"/>
            <Setter Property="CornerRadius" Value="2.5"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="MenuTopmost" Header="Always on top" IsCheckable="True" Click="OnTopmostClick"/>
            <MenuItem x:Name="MenuLocked" Header="Lock position" IsCheckable="True" Click="OnLockClick"/>
            <MenuItem Header="Move to next monitor" Click="OnNextMonitorClick"/>
            <MenuItem Header="Hide (show again from Z Launcher)" Click="OnHideClick"/>
            <Separator/>
            <MenuItem Header="Exit" Click="OnExitClick"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="Root" Padding="14,12,14,14" Background="#38000000">
        <StackPanel>
            <!-- FPS (collapsed: just the FPS number) -->
            <Grid x:Name="FpsCard">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.ColumnSpan="2" Style="{StaticResource Flat}" Tag="Fps" Click="OnSectionToggle" ToolTip="Show / hide FPS details">
                    <DockPanel>
                        <TextBlock x:Name="FpsChevron" DockPanel.Dock="Right" Style="{StaticResource Chevron}"/>
                        <TextBlock x:Name="AppName" Text="No game running" Style="{StaticResource Caption}" HorizontalAlignment="Left"/>
                    </DockPanel>
                </Button>
                <TextBlock Grid.Row="1" Margin="0,-2,0,0">
                    <Run x:Name="FpsValue" Text="--" FontSize="44" FontWeight="SemiBold"/><Run Text=" FPS" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Dim}"/>
                </TextBlock>
                <StackPanel x:Name="FpsLowPanel" Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <TextBlock Text="1% LOW" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="LowValue" Text="--" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Per-frame frame-time graph: spikes = stutter -->
                <Grid x:Name="FpsDetail" Grid.Row="2" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Height="34" Margin="0,0,12,0">
                        <local:Sparkline x:Name="FrameGraph" Stroke="#FF453A" Capacity="300" MinimumMax="20"/>
                        <TextBlock Text="FRAME TIME" Style="{StaticResource Label}" VerticalAlignment="Top"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold"><Run x:Name="FrameTime" Text="--"/><Run Text=" ms" FontSize="11" Foreground="{StaticResource Dim}"/></TextBlock>
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}" FontSize="10"><Run Text="max "/><Run x:Name="FrameMax" Text="--"/></TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- CPU (collapsed: usage + temp in the header) -->
            <Border x:Name="CpuCard" Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Button Style="{StaticResource Flat}" Padding="12,10,12,10" Tag="Cpu" Click="OnSectionToggle" ToolTip="Show / hide CPU details">
                        <DockPanel>
                            <TextBlock Text="CPU" Style="{StaticResource CardTitle}" Foreground="{StaticResource CpuBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CpuChevron" DockPanel.Dock="Right" Style="{StaticResource Chevron}"/>
                            <TextBlock x:Name="CpuName" DockPanel.Dock="Right" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock x:Name="CpuSummary" DockPanel.Dock="Right" Style="{StaticResource Summary}"><Run x:Name="CpuLoadS" Text="--"/><Run Text="%" Foreground="{StaticResource Dim}"/><Run Text="     "/><Run x:Name="CpuTempS" Text="--"/><Run Text="°C" Foreground="{StaticResource Dim}"/></TextBlock>
                        </DockPanel>
                    </Button>
                    <StackPanel x:Name="CpuBody" Margin="12,0,12,12">
                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock Text="USAGE" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}"><Run x:Name="CpuLoad" Text="--"/><Run Text="%" FontSize="12" Foreground="{StaticResource Dim}"/></TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="POWER" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}"><Run x:Name="CpuPower" Text="--"/><Run Text=" W" FontSize="12" Foreground="{StaticResource Dim}"/></TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="TEMP" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}"><Run x:Name="CpuTemp" Text="--"/><Run Text="°C" FontSize="12" Foreground="{StaticResource Dim}"/></TextBlock>
                            </StackPanel>
                        </UniformGrid>
                        <Grid Height="46" Margin="0,8,0,0">
                            <local:Sparkline x:Name="CpuGraph" Stroke="#0A84FF" MinimumMax="5"/>
                            <TextBlock Text="CLOCK" Style="{StaticResource Label}" VerticalAlignment="Top"/>
                            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"><Run x:Name="CpuClock" Text="--"/><Run Text=" GHz" Foreground="{StaticResource Dim}"/></TextBlock>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- GPU (collapsed: usage + temp in the header) -->
            <Border x:Name="GpuCard" Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Button Style="{StaticResource Flat}" Padding="12,10,12,10" Tag="Gpu" Click="OnSectionToggle" ToolTip="Show / hide GPU details">
                        <DockPanel>
                            <TextBlock Text="GPU" Style="{StaticResource CardTitle}" Foreground="{StaticResource GpuBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GpuChevron" DockPanel.Dock="Right" Style="{StaticResource Chevron}"/>
                            <TextBlock x:Name="GpuName" DockPanel.Dock="Right" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock x:Name="GpuSummary" DockPanel.Dock="Right" Style="{StaticResource Summary}"><Run x:Name="GpuLoadS" Text="--"/><Run Text="%" Foreground="{StaticResource Dim}"/><Run Text="     "/><Run x:Name="GpuTempS" Text="--"/><Run Text="°C" Foreground="{StaticResource Dim}"/></TextBlock>
                        </DockPanel>
                    </Button>
                    <StackPanel x:Name="GpuBody" Margin="12,0,12,12">
                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock Text="USAGE" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}"><Run x:Name="GpuLoad" Text="--"/><Run Text="%" FontSize="12" Foreground="{StaticResource Dim}"/></TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="POWER" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}"><Run x:Name="GpuPower" Text="--"/><Run Text=" W" FontSize="12" Foreground="{StaticResource Dim}"/></TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="TEMP" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}"><Run x:Name="GpuTemp" Text="--"/><Run Text="°C" FontSize="12" Foreground="{StaticResource Dim}"/></TextBlock>
                            </StackPanel>
                        </UniformGrid>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="VRAM" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"><Run x:Name="VramText" Text="--"/><Run Text=" GB" Foreground="{StaticResource Dim}"/></TextBlock>
                            <Grid Margin="10,0,10,0" VerticalAlignment="Center">
                                <Border Style="{StaticResource Track}"/>
                                <Border Style="{StaticResource Track}" Background="{StaticResource GpuBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="VramBar" ScaleX="0"/></Border.RenderTransform>
                                </Border>
                            </Grid>
                        </DockPanel>
                        <Grid Height="46" Margin="0,8,0,0">
                            <local:Sparkline x:Name="GpuGraph" Stroke="#BF5AF2" MinimumMax="3"/>
                            <TextBlock Text="CLOCK" Style="{StaticResource Label}" VerticalAlignment="Top"/>
                            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"><Run x:Name="GpuClock" Text="--"/><Run Text=" GHz" Foreground="{StaticResource Dim}"/></TextBlock>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- MEMORY (collapsed: used / total in the header) -->
            <Border x:Name="RamCard" Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Button Style="{StaticResource Flat}" Padding="12,10,12,10" Tag="Ram" Click="OnSectionToggle" ToolTip="Show / hide memory details">
                        <DockPanel>
                            <TextBlock Text="MEMORY" Style="{StaticResource CardTitle}" Foreground="{StaticResource RamBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RamChevron" DockPanel.Dock="Right" Style="{StaticResource Chevron}"/>
                            <TextBlock x:Name="RamPctHeader" DockPanel.Dock="Right" Style="{StaticResource Summary}"><Run x:Name="RamPct" Text="--"/><Run Text="%" Foreground="{StaticResource Dim}"/></TextBlock>
                            <TextBlock x:Name="RamSummary" DockPanel.Dock="Right" Style="{StaticResource Summary}"><Run x:Name="RamUsedS" Text="--"/><Run x:Name="RamTotalS" Text=" / -- GB" Foreground="{StaticResource Dim}"/></TextBlock>
                        </DockPanel>
                    </Button>
                    <StackPanel x:Name="RamBody" Margin="12,0,12,12">
                        <TextBlock Style="{StaticResource Value}" Margin="0,0,0,0"><Run x:Name="RamUsed" Text="--"/><Run x:Name="RamTotal" Text=" / -- GB" FontSize="12" Foreground="{StaticResource Dim}"/></TextBlock>
                        <Grid Margin="0,8,0,0">
                            <Border Style="{StaticResource Track}"/>
                            <Border Style="{StaticResource Track}" Background="{StaticResource RamBrush}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="RamBar" ScaleX="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- NETWORK (collapsible) -->
            <Border x:Name="NetCard" Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Button Style="{StaticResource Flat}" Padding="12,10,12,10" Tag="Net" Click="OnSectionToggle" ToolTip="Show / hide network details">
                        <DockPanel>
                            <TextBlock Text="NETWORK" Style="{StaticResource CardTitle}" Foreground="{StaticResource NetBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NetChevron" DockPanel.Dock="Right" Style="{StaticResource Chevron}"/>
                            <TextBlock HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="&#x2193; " Foreground="{StaticResource NetBrush}"/><Run x:Name="NetDownSummary" Text="--"/><Run Text="    &#x2191; " Foreground="{StaticResource UpBrush}"/><Run x:Name="NetUpSummary" Text="--"/>
                            </TextBlock>
                        </DockPanel>
                    </Button>

                    <StackPanel x:Name="NetBody" Visibility="Collapsed" Margin="12,0,12,12">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="DOWNLOAD" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}" FontSize="18"><Run x:Name="NetDown" Text="--"/><Run x:Name="NetDownUnit" Text="" FontSize="11" Foreground="{StaticResource Dim}"/></TextBlock>
                                <local:Sparkline x:Name="NetDownGraph" Stroke="#64D2FF" MinimumMax="102400" Height="28" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="UPLOAD" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Value}" FontSize="18"><Run x:Name="NetUp" Text="--"/><Run x:Name="NetUpUnit" Text="" FontSize="11" Foreground="{StaticResource Dim}"/></TextBlock>
                                <local:Sparkline x:Name="NetUpGraph" Stroke="#30D158" MinimumMax="102400" Height="28" Margin="0,4,0,0"/>
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="TOP APPS" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                        <ItemsControl x:Name="NetApps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="68"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" FontSize="11" HorizontalAlignment="Right"><Run Text="&#x2193; " Foreground="{StaticResource NetBrush}"/><Run Text="{Binding Down, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Grid.Column="2" FontSize="11" HorizontalAlignment="Right"><Run Text="&#x2191; " Foreground="{StaticResource UpBrush}"/><Run Text="{Binding Up, Mode=OneWay}"/></TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NetAppsEmpty" Text="Measuring..." Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
