<Window x:Class="ZLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z Launcher" Icon="pack://application:,,,/z.ico"
        Width="440" Height="640" WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="Transparent" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Display, Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" Background="#40000000" Padding="18,14,18,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header (drag to move) -->
            <DockPanel Background="Transparent" MouseLeftButtonDown="OnHeaderDown">
                <Image Source="pack://application:,,,/z.ico" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Width="30" Height="30" Click="OnCloseClick" ToolTip="Close">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Width="30" Height="30" Click="OnMinimizeClick" ToolTip="Minimize (Ctrl+Alt+Z)">
                    <TextBlock Text="&#xE921;" FontFamily="{StaticResource Icons}" FontSize="11"/>
                </Button>
                <TextBlock Text="Z Launcher" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>

            <!-- Pill: Apps | Widgets -->
            <Border x:Name="Pill" Grid.Row="1" Width="232" Height="36" CornerRadius="18" Background="#1AFFFFFF"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,14,0,16">
                <Grid>
                    <Border x:Name="PillThumb" Width="112" Margin="3" HorizontalAlignment="Left" CornerRadius="15" Background="#38FFFFFF">
                        <Border.RenderTransform><TranslateTransform x:Name="ThumbX"/></Border.RenderTransform>
                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25"/></Border.Effect>
                    </Border>
                    <UniformGrid Columns="2">
                        <Button x:Name="AppsTab" Style="{StaticResource Flat}" Tag="0" Click="OnTabClick" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,1,7,0"/>
                                <TextBlock Text="Apps" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="WidgetsTab" Style="{StaticResource Flat}" Tag="1" Click="OnTabClick" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF0E2;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,1,7,0"/>
                                <TextBlock Text="Widgets" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Pages slide sideways inside this viewport (Canvas: no layout clipping of the 2-page strip) -->
            <Grid x:Name="Viewport" Grid.Row="2" ClipToBounds="True" SizeChanged="OnViewportSize">
                <Canvas>
                <StackPanel x:Name="Strip" Orientation="Horizontal">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="StripX"/></StackPanel.RenderTransform>

                    <!-- ===== APPS: only the apps you add (button, or drop an .exe / shortcut here) ===== -->
                    <Grid x:Name="AppsPage" AllowDrop="True" Background="Transparent" DragOver="OnAppsDragOver" Drop="OnAppsDrop">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Margin="8,0,0,0" Padding="12,0" Click="OnAddAppClick" ToolTip="Add an app (.exe or shortcut)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,1,7,0"/>
                                    <TextBlock Text="Add" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Border CornerRadius="12" Background="{StaticResource Fill}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="12,8">
                                <DockPanel>
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Grid>
                                        <TextBlock x:Name="SearchHint" Text="Search my apps" Foreground="{StaticResource Faint}" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBox x:Name="Search" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" CaretBrush="White"
                                                 FontSize="13" Padding="0" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKey"/>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" Margin="0,14,-10,0" Padding="0,0,10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel>
                                <TextBlock x:Name="AppsLabel" Text="MY APPS" Style="{StaticResource Label}"/>
                                <ItemsControl x:Name="AppList" ItemTemplate="{DynamicResource TileTemplate}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="AppsStatus" Text="No matching apps" Style="{StaticResource Caption}" Margin="4,6,0,0" Visibility="Collapsed"/>

                                <!-- Empty state -->
                                <StackPanel x:Name="AppsEmpty" HorizontalAlignment="Center" Margin="0,70,0,0" Visibility="Collapsed">
                                    <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource Fill}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE71D;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No apps yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                                    <TextBlock Text="Your apps will show up here." Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click Add, or drop an .exe or shortcut on this page." Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== WIDGETS ===== -->
                    <ScrollViewer x:Name="WidgetsPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="WIDGETS" Style="{StaticResource Label}"/>

                            <!-- ZMonitor -->
                            <Border CornerRadius="16" Background="{StaticResource Fill}" BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="16,14">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Width="42" Height="42" CornerRadius="11" Margin="0,0,12,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#30D158" Offset="0"/>
                                                    <GradientStop Color="#0A84FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ToggleButton x:Name="MonitorSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="OnMonitorSwitch" Unchecked="OnMonitorSwitch" ToolTip="Show / hide the widget"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="ZMonitor" FontSize="15" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Faint}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                                <TextBlock x:Name="StatusText" Text="Checking..." Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="FPS, CPU, GPU, memory and network, always on top." Style="{StaticResource Caption}" Margin="0,10,0,0"/>

                                    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,14"/>

                                    <TextBlock Text="SECTIONS" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                                    <WrapPanel x:Name="SectionChips">
                                        <ToggleButton Style="{StaticResource Chip}" Content="FPS" Tag="ShowFps" Checked="OnSectionChip" Unchecked="OnSectionChip"/>
                                        <ToggleButton Style="{StaticResource Chip}" Content="CPU" Tag="ShowCpu" Checked="OnSectionChip" Unchecked="OnSectionChip"/>
                                        <ToggleButton Style="{StaticResource Chip}" Content="GPU" Tag="ShowGpu" Checked="OnSectionChip" Unchecked="OnSectionChip"/>
                                        <ToggleButton Style="{StaticResource Chip}" Content="Memory" Tag="ShowRam" Checked="OnSectionChip" Unchecked="OnSectionChip"/>
                                        <ToggleButton Style="{StaticResource Chip}" Content="Network" Tag="ShowNet" Checked="OnSectionChip" Unchecked="OnSectionChip"/>
                                    </WrapPanel>

                                    <Border Height="1" Background="{StaticResource Hairline}" Margin="0,8,0,6"/>

                                    <Grid x:Name="Options">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="48"/>
                                            <RowDefinition Height="44"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Always on top" FontSize="13" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="TopmostSwitch" Grid.Column="1" Style="{StaticResource Switch}" Tag="Topmost" Checked="OnOptionSwitch" Unchecked="OnOptionSwitch"/>

                                        <TextBlock Grid.Row="1" Text="Lock position" FontSize="13" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="LockSwitch" Grid.Row="1" Grid.Column="1" Style="{StaticResource Switch}" Tag="Locked" Checked="OnOptionSwitch" Unchecked="OnOptionSwitch"/>

                                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                            <TextBlock Text="Start with Windows" FontSize="13"/>
                                            <TextBlock Text="Starts at logon with no UAC prompt (asks once to set up)" Style="{StaticResource Caption}" FontSize="10.5"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="AutostartSwitch" Grid.Row="2" Grid.Column="1" Style="{StaticResource Switch}" Checked="OnAutostartSwitch" Unchecked="OnAutostartSwitch"/>

                                        <TextBlock Grid.Row="3" Text="Opacity" FontSize="13" VerticalAlignment="Center"/>
                                        <Slider x:Name="OpacitySlider" Grid.Row="3" Grid.Column="1" Width="150" Minimum="0.3" Maximum="1" Style="{StaticResource Slider}"
                                                VerticalAlignment="Center" IsMoveToPointEnabled="True" ValueChanged="OnOpacityChanged"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="NextMonitorButton" Style="{StaticResource PillButton}" Click="OnNextMonitorClick" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,1,7,0"/>
                                                <TextBlock Text="Next monitor"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="QuitButton" Style="{StaticResource PillButton}" Click="OnQuitClick" Foreground="{StaticResource Red}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,1,7,0"/>
                                                <TextBlock Text="Quit widget"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Ctrl+Alt+Z shows or hides Z Launcher from anywhere." Style="{StaticResource Caption}" Margin="4,14,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
                </Canvas>
            </Grid>
        </Grid>
    </Border>

    <Window.Resources>
        <DataTemplate x:Key="TileTemplate">
            <Button Style="{StaticResource Tile}" Click="OnTileClick" ToolTip="{Binding Name}" ContextMenuOpening="OnTileMenu">
                <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
                <StackPanel Width="80">
                    <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="30" Margin="0,7,0,0" LineHeight="14" LineStackingStrategy="BlockLineHeight"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>
</Window>
